    "2. Add the following methods:\n",
    "    * `shape()`: returns a tuple `(n,m)` of the shape of the matrix.\n",
    "    * `transpose()`: returns a new matrix instance which is the transpose of the matrix.\n",
    "    * `row(n)` and `column(n)`: that return the nth row or column of the matrix M as a new appropriately shaped matrix object.\n",
    "    * `to_list()`: which returns the matrix as a list of lists.\n",
    "    *  `block(n_0,n_1,m_0,m_1)` that returns a smaller matrix located at the n_0 to n_1 columns and m_0 to m_1 rows. \n",
    "    * Modify `__getitem__` implemented above to support slicing.\n",
    "        "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Matrix:\n",
    "    def __init__(self, *args):\n",
    "        if len(args) == 2 and all(isinstance(x, int) for x in args):\n",
    "            n, m = args\n",
    "            if n <= 0 or m <= 0:\n",
    "                raise ValueError\n",
    "            self.rows = n\n",
    "            self.cols = m\n",
    "            self.data = [[0 for _ in range(m)] for _ in range(n)]\n",
    "        elif len(args) == 1 and isinstance(args[0], list):\n",
    "            data = args[0]\n",
    "            if not data or not all(isinstance(row, list) for row in data):\n",
    "                raise ValueError\n",
    "            row_length = len(data[0])\n",
    "            if row_length == 0:\n",
    "                raise ValueError\n",
    "            for row in data:\n",
    "                if len(row) != row_length:\n",
    "                    raise ValueError\n",
    "            self.rows = len(data)\n",
    "            self.cols = row_length\n",
    "            self.data = [row[:] for row in data]\n",
    "        else:\n",
    "            raise ValueError\n",
    "\n",
    "    def shape(self):\n",
    "        return (self.rows, self.cols)\n",
    "\n",
    "    def transpose(self):\n",
    "        return Matrix([[self.data[i][j] for i in range(self.rows)] for j in range(self.cols)])\n",
    "\n",
    "    def row(self, n):\n",
    "        if n < 0 or n >= self.rows:\n",
    "            raise IndexError\n",
    "        return Matrix([self.data[n][:]])\n",
    "\n",
    "    def column(self, n):\n",
    "        if n < 0 or n >= self.cols:\n",
    "            raise IndexError\n",
    "        return Matrix([[self.data[i][n]] for i in range(self.rows)])\n",
    "\n",
    "    def to_list(self):\n",
    "        return [row[:] for row in self.data]\n",
    "\n",
    "    def block(self, n_0, n_1, m_0, m_1):\n",
    "        if n_0 < 0 or n_1 > self.rows or m_0 < 0 or m_1 > self.cols or n_0 > n_1 or m_0 > m_1:\n",
    "            raise IndexError\n",
    "        return Matrix([self.data[i][m_0:m_1] for i in range(n_0, n_1)])\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        if isinstance(index, tuple):\n",
    "            r, c = index\n",
    "            if isinstance(r, slice) or isinstance(c, slice):\n",
    "                rows = range(*r.indices(self.rows)) if isinstance(r, slice) else [r]\n",
    "                cols = range(*c.indices(self.cols)) if isinstance(c, slice) else [c]\n",
    "                return Matrix([[self.data[i][j] for j in cols] for i in rows])\n",
    "            return self.data[r][c]\n",
    "        return self.data[index]\n",
    "\n",
    "    def __setitem__(self, index, value):\n",
    "        if isinstance(index, tuple):\n",
    "            i, j = index\n",
    "            self.data[i][j] = value\n",
    "        else:\n",
    "            raise TypeError\n",
    "\n",
    "    def assign(self, other):\n",
    "        if isinstance(other, Matrix):\n",
    "            if self.shape() != other.shape():\n",
    "                raise ValueError\n",
    "            self.data = [row[:] for row in other.data]\n",
    "        elif isinstance(other, list):\n",
    "            if len(other) != self.rows or any(len(row) != self.cols for row in other):\n",
    "                raise ValueError\n",
    "            self.data = [row[:] for row in other]\n",
    "        else:\n",
    "            raise TypeError\n",
    "\n",
    "    def __str__(self):\n",
    "        return \"\\n\".join(str(row) for row in self.data)"
   ]
